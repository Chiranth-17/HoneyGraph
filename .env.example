# Copy to .env for local development. Replace every CHANGE_ME value.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGO_INGEST_USERNAME=ingest_svc
MONGO_INGEST_PASSWORD=CHANGE_ME_INGEST_PASSWORD
MONGO_DETECTOR_USERNAME=detect_svc
MONGO_DETECTOR_PASSWORD=CHANGE_ME_DETECTOR_PASSWORD
MONGO_ANALYST_USERNAME=analyst
MONGO_ANALYST_PASSWORD=CHANGE_ME_ANALYST_PASSWORD
MONGO_RULE_ADMIN_USERNAME=rule_admin
MONGO_RULE_ADMIN_PASSWORD=CHANGE_ME_RULE_ADMIN_PASSWORD
MONGO_TAMPER_USERNAME=tamper_demo
MONGO_TAMPER_PASSWORD=CHANGE_ME_TAMPER_PASSWORD
MONGO_API_USERNAME=api_svc
MONGO_API_PASSWORD=CHANGE_ME_API_PASSWORD
MONGO_DATABASE=honeygraph

# Host ports and the single host-side replica-set URI.
MONGO1_PORT=27017
MONGO2_PORT=27018
MONGO3_PORT=27019
MONGODB_URI=mongodb://root:CHANGE_ME_ROOT_PASSWORD@localhost:27017/honeygraph?authSource=admin&replicaSet=rs0&directConnection=true

# Internal service URI used by containers in later phases.
MONGODB_INTERNAL_URI=mongodb://api_svc:CHANGE_ME_API_PASSWORD@mongo1:27017,mongo2:27017,mongo3:27017/honeygraph?authSource=honeygraph&replicaSet=rs0

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
APP_ANALYST_USERNAME=analyst
APP_ANALYST_PASSWORD=CHANGE_ME_ANALYST_APP_PASSWORD
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_APP_PASSWORD
# Development default. CERT-In production deployments should retain events for 180 days.
EVENT_TTL_DAYS=7
RISK_HALF_LIFE_HOURS=6
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=/api
# Leave blank to use the current browser host and /ws/alerts.
VITE_WS_URL=

